// Generated by CMake from app.rc.in at configure time (see app/CMakeLists.txt)
// -- edit this template, not a generated app.rc under the build directory.
//
// Embeds the app icon into lvdExplorer.exe itself, so it shows correctly
// in Explorer/taskbar/shortcuts before the process ever runs -- distinct
// from QApplication::setWindowIcon() in main.cpp, which only sets the
// *window* icon while the app is actually running. IDI_ICON1 (numerically
// lowest icon ID) is what Windows picks as an exe's default icon.
IDI_ICON1 ICON "@LVDEXPLORER_APP_ICON_PATH@"

// File/Product version shown in Explorer's Properties -> Details tab.
// Sourced from project(lvdExplorer VERSION ...) in the root CMakeLists.txt
// via this template's @...@ substitutions -- never hand-edit a version
// number here.
1 VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "lvd Systems"
            VALUE "FileDescription",  "lvdExplorer - multi-pane file manager"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "lvdExplorer"
            VALUE "LegalCopyright",   "Copyright lvd Systems. Licensed under GPLv3."
            VALUE "OriginalFilename", "lvdExplorer.exe"
            VALUE "ProductName",      "lvdExplorer"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
